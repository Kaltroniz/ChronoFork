# ==============================================================================
# ChronoFork Environment Configuration
# ==============================================================================

# FalkorDB Connection (default: 127.0.0.1:6379 for local, 'falkordb' in docker)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# LLM Provider Configuration (Optional for Replay Mode; Required for Live Mode)
# Supported options: 'gemini', 'anthropic', 'openai'
LLM_PROVIDER=gemini

# Provider API Keys
# NOTE: Zero API keys are required to run ChronoFork in Deterministic Replay Mode!
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Security & Deployment Configuration
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
